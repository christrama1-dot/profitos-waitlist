# profitos-waitlist — environment variables (EXAMPLE ONLY — no real values here)
# Real values live in Vercel project env vars + Bitwarden. NEVER commit real secrets.

# ── #42 dashboard server-side auth ──────────────────────────────────────────
# 32-byte random hex. Signs/verifies the dashboard session cookie. Bitwarden: DASH_SESSION_SECRET
SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
# scrypt hash of the Founder access code. Generate with tools/gen-dash-access-hash.js. Bitwarden: DASH_ACCESS_HASH
DASH_ACCESS_HASH=scrypt$16384$8$1$REPLACE_saltHex$REPLACE_keyHex

# ── Vercel KV (Upstash) — auto-set when KV is enabled; used for rate limiting ─
KV_REST_API_URL=REPLACE
KV_REST_API_TOKEN=REPLACE

# ── existing (unchanged, for reference) ─────────────────────────────────────
# FOUNDER_STATS_KEY=...        # protects /api/cc-stats and /api/hook-stats
