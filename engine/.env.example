# ==========================================================================
# ProfitOS Audit Engine (WF-08) — Environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a placeholder name only — no real secrets here.
# ==========================================================================

# --- Server ---------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Public base URL where WF-06 POSTs the handoff (informational / logging)
PUBLIC_BASE_URL=https://engine.profitos.example.com

# --- Inbound auth (shared secret with WF-06 n8n handler) ------------------
# WF-06 must send this exact value in the X-ProfitOS-Audit-Secret header.
WF06_AUDIT_SECRET=

# --- Apollo.io ------------------------------------------------------------
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_TIMEOUT_MS=20000

# --- Lusha ----------------------------------------------------------------
LUSHA_API_KEY=
LUSHA_BASE_URL=https://api.lusha.com
LUSHA_TIMEOUT_MS=15000

# --- Semrush --------------------------------------------------------------
SEMRUSH_API_KEY=
SEMRUSH_BASE_URL=https://api.semrush.com
SEMRUSH_DATABASE=us
SEMRUSH_TIMEOUT_MS=20000

# --- Clay -----------------------------------------------------------------
# Clay REST webhook/endpoint that accepts a JSON enrichment request.
CLAY_API_KEY=
CLAY_WEBHOOK_URL=
CLAY_TIMEOUT_MS=25000

# --- Google Drive (report storage) ----------------------------------------
# Service account JSON, base64-encoded, OR a path to the JSON key file.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Drive folder ID where generated PDF reports are uploaded.
GDRIVE_REPORTS_FOLDER_ID=
# Optional: impersonated user for domain-wide delegation.
GOOGLE_IMPERSONATE_SUBJECT=

# --- Email delivery (SMTP) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=ProfitOS Engine
EMAIL_FROM_ADDRESS=reports@profitos.example.com
# Optional BCC for internal record-keeping.
EMAIL_BCC=

# --- Kit (ConvertKit) callback --------------------------------------------
# Used to apply the "audit-completed" tag to the submitter.
KIT_API_KEY=
KIT_API_SECRET=
KIT_BASE_URL=https://api.kit.com/v4
KIT_AUDIT_COMPLETED_TAG_ID=

# --- Engine tuning --------------------------------------------------------
# Hard ceiling for the whole enrichment phase (ms) before normalization runs.
ENRICHMENT_DEADLINE_MS=90000
# Where to write PDFs before upload.
PDF_OUTPUT_DIR=./tmp
# Prefer puppeteer for PDF; set to "pdfkit" to force the fallback renderer.
PDF_RENDERER=puppeteer
# Log level: debug | info | warn | error
LOG_LEVEL=info
